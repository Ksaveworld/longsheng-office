{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["iad1"],
  "functions": { "api/office.mjs": { "maxDuration": 60, "includeFiles": "server/**" } },
  "rewrites": [
    { "source": "/api/office/:path*", "destination": "/api/office?route=/api/office/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
